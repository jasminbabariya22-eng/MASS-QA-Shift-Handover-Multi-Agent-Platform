# ============================================================
# MASS QA & Shift Handover Platform — Environment Template
# ============================================================

# LLM Providers
GEMINI_API_KEY=your_gemini_api_key_here
GROQ_API_KEY=your_groq_api_key_here
GROQ_FALLBACK_API_KEY=your_backup_groq_api_key_here
PORTKEY_API_KEY=your_portkey_api_key_here

# Qdrant Vector DB Settings
QDRANT_API_KEY=your_qdrant_api_key_here
QDRANT_CLUSTER_ENDPOINT=https://your-cluster-id.aws.cloud.qdrant.io
QDRANT_COLLECTION=mass_qa_multimodal

# PostgreSQL Persistence
DATABASE_URL=postgresql://user:password@localhost:5432/mass_qa_db

# Redis Cache (Optional, falls back to in-memory)
REDIS_URL=redis://localhost:6379/0

# Observability
LOGFIRE_TOKEN=your_logfire_token_here
LANGSMITH_TRACING=false
LANGSMITH_ENDPOINT=https://api.smith.langchain.com
LANGSMITH_API_KEY=your_langsmith_api_key_here
LANGSMITH_PROJECT=mass-qa-system

# Security & Gateway
JWT_SECRET_KEY=your-secure-random-secret-key-32-chars-minimum
ACCESS_TOKEN_EXPIRE_MINUTES=480
CORS_ALLOWED_ORIGINS=["http://localhost:8501"]
